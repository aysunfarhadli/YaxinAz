# Database
DB_URL=jdbc:postgresql://localhost:5432/yaxinaz_db
DB_USERNAME=yaxinaz
DB_PASSWORD=change-me

# Security
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
